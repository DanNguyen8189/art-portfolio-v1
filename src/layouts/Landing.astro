<style>
	html,
	body {
		margin: 0;
		/* width: 100%;
		height: 100%; */
		min-height: 100vh;
		margin: 0;
		/* display: grid;
		grid-template-rows: auto 1fr auto; */
        display: flex;
        align-items: flex-end;
        width: 100%;
        background-color: rgba(0,0,0,.5);
	}
	#background {
		position: fixed;
		top: 0;
		left: 0;
        width: 100vw;
        height: 100vh;
        object-fit: cover;
        object-position: center;
        pointer-events: none;
		z-index: -1;
        /* filter: brightness(0.8); */
	}
    .hero {
        width: 100%;
        padding: 3rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .title-card {
        display: flex;
        flex-direction: column;
        color: white;
    }
    .brand {
        font-size: 2rem;
        text-decoration: none;
        color: inherit;
        font-family: "variete-cabaret";
    }
    /* Social Links */
    .social-links {
        display: flex;
        gap: 1rem;
    }
    .social-link {
        color: white;
        transition: color var(--transition-duration);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid white; /* Border color and thickness */
        border-radius: 50%; /* Makes it a perfect circle */
        padding: .5rem;
    }
    .social-link:hover {
        color: var(--color-indigo-600);
        border: 1px solid var(--color-indigo-600);
    }
    .social-icon {
        height: 1rem;
        width: 1rem;
        display: block;
        color: inherit;
        fill: currentColor;
        stroke: currentColor;
        flex-shrink: 0;
    }
    .btn {
        align-self: flex-end;
        display: inline-block;
        padding: 0.6rem 1.2rem;
        background-color: white;
        color: var(--color-slate-600);
        text-decoration: none;
        font-weight: 600;
        transition: background-color 0.2s ease;
    }

    .btn:hover {
        background-color: var(--color-indigo-600);
        color: white;
    }
</style>