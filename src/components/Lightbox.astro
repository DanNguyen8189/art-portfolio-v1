---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
    image: ImageMetadata;
    alt?: string;
};

const { image, alt = "" } = Astro.props as Props;
const dialogId = `lightbox-${image.src.replace(/[^a-zA-Z0-9]/g, "-")}`;
---
<div class="container">
<button 
    class="lightbox-trigger" 
    type="button" 
    aria-label={`Open ${alt || "image"}`} 
    data-lightbox-trigger={dialogId}>
    <Image 
        src={image} 
        alt={alt} 
        class="thumbnail" 
        loading="eager" 
    />
</button>

<dialog class="lightbox" id={dialogId} aria-label={alt || "Image preview"}>
    <button class="close" type="button" aria-label="Close image preview" data-lightbox-close>×</button>
    <Image src={image} alt={alt} class="img-preview" />
    {alt && <p class="caption">{alt}</p>}
</dialog>
</div>

<script>
    document.querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]").forEach((trigger) => {
        const dialog = document.getElementById(trigger.dataset.lightboxTrigger ?? "");
        if (!(dialog instanceof HTMLDialogElement)) return;

        trigger.addEventListener("click", () => dialog.showModal());
        dialog.querySelector<HTMLButtonElement>("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (event) => {
            if (event.target === dialog) dialog.close();
        });
    });
</script>

<style>
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .lightbox-trigger {
        display: block;
        width: 100%;
        padding: 0;
        border: 0;
        background: transparent;
        cursor: zoom-in;
        box-sizing: border-box
    }

    .thumbnail {
        display: block;
        width: 100%;
        height: auto;
        animation: fadeIn 700ms ease forwards;
    }

    .lightbox {
        box-sizing: border-box;
        /* width: min(calc(100vw - 2rem), 1200px); */
        width: 100%;
        max-width: none;
        height: min(calc(100vh - 2rem), 900px);
        max-height: none;
        margin: auto;
        padding: 3rem 1rem 1rem;
        border: 0;
        background: none;
        color: #fff;
    }

    .lightbox::backdrop {
        background: rgb(0 0 0 / 0.85);
    }

    .close {
        position: absolute;
        top: 0.75rem;
        right: 1rem;
        color: #fff; 
        font-size: 2.2rem;
        line-height: 1;
        border: 0;
        background: transparent;
        cursor: pointer; 
    }

    .img-preview {
        display: block;
        width: 100%;
        height: calc(100% - 3rem);
        object-fit: contain;
    }

    .caption {
        margin: 0.5rem 0 0;
        color: #94a3b8;
    }

    @media (max-width: 500px) {
        .lightbox {
            width: calc(100vw - 1rem);
            height: calc(100vh - 1rem);
            padding: 3rem 0.5rem 0.5rem;
        }
    }
</style>
