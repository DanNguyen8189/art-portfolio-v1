---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon, OpenIcon, CloseIcon, StickyHeader } from "astro-navbar";

const menuitems = [
  {
    title: "Work",
    path: "#",
    children: [
      { title: "Yogurtwurld", path: "#" },
    ],
  },
  {
    title: "Personal",
    path: "#",
    children: [
      { title: "USPS", path: "#"},
      { title: "Horns and Hooves", path:"#"}
    ]
  },
  {
    title: "Illustrations",
    path: "/illustrations",
  },
  {
    title: "About",
    path: "/about",
  },
  {
    title: "Contact",
    path: "/contact",
  },
  // {
  //   title: "Pro Version",
  //   badge: true,
  //   path: "https://astroship-pro.web3templates.com/",
  // },
];
---

<Container class="test">
  <!-- <header class="navbar-header"> -->
    <StickyHeader
      class="navbar-sticky-header"
      scrollY={50}
      defaultClass="navbar-sticky-default"
      activeClass="navbar-sticky-active">
    <Astronav>
      <div class="navbar-top">
        <div class="title-card">
        <a href="/" class="navbar-brand">
          <span class="navbar-brand-main">Dan N</span>
          <span class="navbar-brand-sub">guyen</span>
        </a>
        <div>Visual Development & Illustration</div>
        </div>
        <div class="navbar-menu-toggle">
          <MenuIcon>
            <!-- Icons from https://www.svgrepo.com/ -->
            <OpenIcon class="navbar-menu-svg">
              <svg class="navbar-menu-svg" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" 
