<style>
.test{
  background-color: green;
}
.navbar-sticky-header {
  /* background-color: purple; */
  padding: 1.25rem;
  position: sticky;
  top: 0;
  z-index: 20;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  border-bottom: 1px solid transparent;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
}

.navbar-sticky-default {
  padding-top: 1.25rem;
  padding-bottom: 1.25rem;
  border-color: transparent;
}

.navbar-sticky-active {
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
  background-color: rgba(255, 255, 255, 0.8);
  border-color: #e5e7eb;
  backdrop-filter: blur(16px);
}

.navbar-header {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 1.25rem 1.25rem;
}

.navbar-top {
  display: flex;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  align-items: start;
  justify-content: space-between;
}

.navbar-brand {
  font-size: 2rem;
  text-decoration: none;
  color: inherit;
  font-family: "variete-cabaret";
}

.navbar-brand-main {
  font-weight: 700;
  color: #0f172a;
}

.navbar-brand-sub {
  color: #64748b;
}

.navbar-menu-toggle {
  /* margin-left: auto; */
  display: block;
}

.title-card {
  display: flex;
  flex-direction: column;
  align-items: start;
  margin-right: auto;
}

@font-face {
  font-family: 'variete-cabaret';
  src: url('../../assets/fonts/variete-font/VarieteCabaret-zJZa.ttf') format('truetype');
  /* font-weight: normal;
  font-style: normal; */
}

/** reset button styling, remove border and bg. global needed because we're trying to style the astro-navbar
component and the scoped selectors here won't reach it otherwise */
:global(#astronav-menu) {
  padding: 0;
  border: 0;
  line-height: 0;
  appearance: none;
  -webkit-appearance: none;
  margin: 0;
  background-color: transparent;
}


.navbar-menu-svg {
  width: 2rem;
  height: 2rem;
  fill: black;
  /* color: #1f2937; */
}

/** global needed for .hidden class to get applied to astronav menu icon, and switch between open and close icons
otherwise both are shown at all times*/
:global(.hidden) .navbar-menu-svg{
  display: none !important;
}

.navbar-items {
  display: none;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  margin-top: 0.5rem;
}

.navbar-items:not(.hidden) {
  display: flex;
}

.navbar-nav-list {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  list-style: none;
  padding: 0;
  margin: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

:global(html),
:global(body) {
  overflow-x: clip;
}

.navbar-link {
  display: flex;
  align-items: center;
  padding: 0.5rem 0;
  color: #4b5563;
  text-decoration: none;
}

.navbar-link:hover {
  color: #111827;
}

.navbar-badge {
  margin-left: 0.25rem;
  padding: 0.125rem 0.5rem;
  font-size: 0.625rem;
  font-weight: 600;
  line-height: 1;
  text-transform: uppercase;
  color: #ffffff;
  background-color: #4f46e5;
  border-radius: 999px;
  animation: navbar-pulse 1.5s infinite;
}

.navbar-mobile-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-top: 0.75rem;
}

.navbar-auth {
  display: none;
  align-items: center;
  gap: 1rem;
}

@keyframes navbar-pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.04);
    opacity: 0.9;
  }
}

@media (min-width: 1024px) {
  .navbar-header {
    flex-direction: row;
  }

  .navbar-top {
    width: auto;
  }

  .title-card {
    align-items: center;
    /* margin-right: auto; */
    /* margin: auto; */
  }

  .navbar-brand {
    font-size: 3rem;
  }

  .navbar-menu-toggle {
    display: none;
  }

  .navbar-items {
    display: flex;
    width: auto;
    margin-top: 0;
  }

  /* .navbar-items:not(.hidden) {
    display: flex;
  } */

  .navbar-nav-list {
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
  }

  .navbar-link {
    padding: 0.5rem 0.75rem;
  }

  .navbar-mobile-actions {
    display: none;
  }

  .navbar-auth {
    display: flex;
  }
}

</style>