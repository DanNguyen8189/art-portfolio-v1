---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon, StickyHeader } from "astro-navbar";

const menuitems = [
  {
    title: "Work",
    path: "#",
    children: [
      { title: "Yogurtwurld", path: "#" },
    ],
  },
  {
    title: "Personal",
    path: "#",
    children: [
      { title: "USPS", path: "#"},
      { title: "Horns and Hooves", path:"#"}
    ]
  },
  {
    title: "Illustrations",
    path: "/illustrations",
  },
  {
    title: "About",
    path: "/about",
  },
  {
    title: "Contact",
    path: "/contact",
  },
  // {
  //   title: "Pro Version",
  //   badge: true,
  //   path: "https://astroship-pro.web3templates.com/",
  // },
];
---

<Container>
  <!-- <header class="navbar-header"> -->
    <StickyHeader
      class="navbar-sticky-header"
      scrollY={50}
      defaultClass="navbar-sticky-default"
      activeClass="navbar-sticky-active">
    <Astronav>
      <div class="navbar-top">
        <a href="/" class="navbar-brand">
          <span class="navbar-brand-sub">Dan</span>
          <span class="navbar-brand-main">Nguyen</span>
        </a>
        <div class="navbar-menu-toggle">
          <MenuIcon class="navbar-menu-icon" />
        </div>
      </div>
      <MenuItems class="navbar-items">
        <ul class="navbar-nav-list">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="navbar-link">
                      <span> {item.title}</span>
                      {/* {item.badge && (
                        <span class="navbar-badge">
                          New
                        </span>
                      )} */}
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <!-- <div class="navbar-mobile-actions">
          <Link href="#" style="muted" block size="md">Log in</Link>
          <Link href="#" size="md" block>Sign up</Link>
        </div> -->
      </MenuItems>
    </Astronav>
    <!-- <div>
      <div class="navbar-auth">
        <a href="#">Log in</a>
        <Link href="#" size="md">Sign up</Link>
      </div>
    </div> -->
    </StickyHeader>
  <!-- </header> -->
</Container>

<style>
.navbar-sticky-header {
  position: sticky;
  top: 0;
  z-index: 20;
  border-bottom: 1px solid transparent;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
}

.navbar-sticky-default {
  padding-top: 1.25rem;
  padding-bottom: 1.25rem;
  border-color: transparent;
}

.navbar-sticky-active {
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
  background-color: rgba(255, 255, 255, 0.8);
  border-color: #e5e7eb;
  backdrop-filter: blur(16px);
}

.navbar-header {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  /* padding: 1.25rem 1.25rem; */
}

.navbar-top {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
}

.navbar-brand {
  font-size: 1.125rem;
  text-decoration: none;
  color: inherit;
}

.navbar-brand-main {
  font-weight: 700;
  color: #0f172a;
}

.navbar-brand-sub {
  color: #64748b;
}

.navbar-menu-toggle {
  display: block;
}

.navbar-menu-icon {
  width: 1rem;
  height: 1rem;
  color: #1f2937;
}

.navbar-items {
  display: none;
  width: 100%;
  margin-top: 0.5rem;
}

.navbar-items:not(.hidden) {
  display: flex;
}

.navbar-nav-list {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  list-style: none;
  padding: 0;
  margin: 0;
  width: 100%;
}

.navbar-link {
  display: flex;
  align-items: center;
  padding: 0.5rem 0;
  color: #4b5563;
  text-decoration: none;
}

.navbar-link:hover {
  color: #111827;
}

.navbar-badge {
  margin-left: 0.25rem;
  padding: 0.125rem 0.5rem;
  font-size: 0.625rem;
  font-weight: 600;
  line-height: 1;
  text-transform: uppercase;
  color: #ffffff;
  background-color: #4f46e5;
  border-radius: 999px;
  animation: navbar-pulse 1.5s infinite;
}

.navbar-mobile-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-top: 0.75rem;
}

.navbar-auth {
  display: none;
  align-items: center;
  gap: 1rem;
}

@keyframes navbar-pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.04);
    opacity: 0.9;
  }
}

@media (min-width: 1024px) {
  .navbar-header {
    flex-direction: row;
  }

  .navbar-top {
    width: auto;
  }

  .navbar-menu-toggle {
    display: none;
  }

  .navbar-items {
    display: flex;
    width: auto;
    margin-top: 0;
  }

  /* .navbar-items:not(.hidden) {
    display: flex;
  } */

  .navbar-nav-list {
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
  }

  .navbar-link {
    padding: 0.5rem 0.75rem;
  }

  .navbar-mobile-actions {
    display: none;
  }

  .navbar-auth {
    display: flex;
  }
}

</style>