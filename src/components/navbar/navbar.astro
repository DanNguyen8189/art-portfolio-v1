<style>
/* .navbar-sticky-header {
  padding: 1.25rem;
  position: sticky;
  top: 0;
  z-index: 20;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  border-bottom: 1px solid transparent;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
