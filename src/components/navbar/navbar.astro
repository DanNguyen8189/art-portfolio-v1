---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon, OpenIcon, CloseIcon, StickyHeader } from "astro-navbar";

const menuitems = [
  {
    title: "Work",
    path: "#",
    children: [
      { title: "Yogurtwurld", path: "#" },
    ],
  },
  {
    title: "Personal",
    path: "#",
    children: [
      { title: "USPS", path: "#"},
      { title: "Horns and Hooves", path:"#"}
    ]
  },
  {
    title: "Illustrations",
    path: "/illustrations",
  },
  {
    title: "About",
    path: "/about",
  },
  {
    title: "Contact",
    path: "/contact",
  },
  // {
  //   title: "Pro Version",
  //   badge: true,
  //   path: "https://astroship-pro.web3templates.com/",
  // },
];
---

