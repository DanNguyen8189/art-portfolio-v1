.navbar-sticky-default {
  padding-top: 1.25rem;
  padding-bottom: 1.25rem;
  border-color: transparent;
}

.navbar-sticky-active {
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
  background-color: rgba(255, 255, 255, 0.8);
  border-color: #e5e7eb;
  backdrop-filter: blur(16px);
} */

.navbar-header {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 1.25rem 1.25rem;
}

.brand {
  font-size: 1.2rem;
  text-decoration: none;
  color: inherit;
  font-family: var(--font-brand);
}

.brand-main {
  font-weight: 700;
  color: #0f172a;
}

.brand-sub {
  color: #64748b;
}
.role {
  font-size: .8rem;
}
.navbar-menu-toggle {
  margin-left: auto;
  display: block;
  position: absolute;
  top: 1.25rem;
  right: 1rem;
}

.title-card {
  display: flex;
  flex-direction: column;
  align-items: start;
  /* margin-right: auto; */
  width: 100%;
}

/** reset button styling, remove border and bg. global needed because we're trying to style the astro-navbar
component and the scoped selectors here won't reach it otherwise */
:global(#astronav-menu) {
  padding: 0;
  border: 0;
  line-height: 0;
  appearance: none;
  -webkit-appearance: none;
  margin: 0;
  background-color: transparent;
}

/* .svg-container {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.navbar-open-icon,
.navbar-close-icon {
  display: inline-flex;
} */
.navbar-menu-svg {
  width: 2.5rem;
  height: 2.5rem;
  fill: black;
  /* color: #1f2937; */
}

/** global needed for .hidden class to get applied to astronav menu icon, and switch between open and close icons
otherwise both are shown at all times*/
:global(.hidden) .navbar-menu-svg{
  display: none !important;
}

.navbar-items {
  display: grid; /** so we can animate w/o hardcoding height; 
  makes container naturally grow in height as opposed to display: flex
  which gives a smoother animation */
  grid-template-rows: 0fr; /** start out closed */
  opacity: 0;
  /* transform: translateY(-0.75rem); */
  transition: grid-template-rows 0.5s ease, opacity 0.5s ease;
  pointer-events: none;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.navbar-items > * {
  min-height: 0;
  overflow: hidden;
}

.navbar-items:not(.hidden) {
  /** astro-navbar applies the .hidden class when the menu toggle is clicked */
  grid-template-rows: 1fr;
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.navbar-items.hidden {
  display: grid !important;
}

.navbar-nav-list {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  list-style: none;
  padding: 0;
  margin: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

:global(html),
:global(body) {
  overflow-x: clip;
}

.navbar-link {
  display: flex;
  align-items: center;
  padding: 0.5rem 0;
  /* color: #4b5563; */
  color: var(--color-slate-500);
  text-decoration: none;
}

.navbar-link:hover {
  color: #111827;
}

.navbar-badge {
  margin-left: 0.25rem;
  padding: 0.125rem 0.5rem;
  font-size: 0.625rem;
  font-weight: 600;
  line-height: 1;
  text-transform: uppercase;
  color: #ffffff;
  background-color: #4f46e5;
  border-radius: 999px;
  animation: navbar-pulse 1.5s infinite;
}

.navbar-mobile-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-top: 0.75rem;
}

.navbar-auth {
  display: none;
  align-items: center;
  gap: 1rem;
}

/* Social Links */
.social-links {
  margin-top: 2rem;
  display: none;
  gap: 1rem;
  align-self: flex-start;
}
.social-link {
  color: var(--color-slate-600);
  transition: color var(--transition-duration);
  display: inline-flex;
  border: 1px solid var(--color-slate-600); 
  border-radius: 50%;
  padding: .5rem;
}
.social-link:hover {
  color: var(--color-indigo-600);
  border: 1px solid var(--color-indigo-600);
}
.social-icon {
  height: 1rem;
  width: 1rem;
  display: block;
  color: inherit;
  fill: currentColor;
  stroke: currentColor;
  flex-shrink: 0;
}

@keyframes navbar-pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.04);
    opacity: 0.9;
  }
}

@media (min-width: 1024px) {
  .navbar-header {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);             
    z-index: 1;
    background: white;
    padding: 2rem;
    width: 18%;
    /* align-items: left; */
  }

  .title-card {
    align-items: left;
    /* padding-top: 2rem;
    padding-bottom: 1rem; */
  }

  .brand {
    font-size: 2.5rem;
  }

  .navbar-menu-toggle {
    display: none;
  }

  .navbar-items,
  .navbar-items.hidden {
    /** on desktop the menu toggle is hidden, so the mobile "hidden" class
    never gets removed by JS -- force the items open here, without the
    collapse/opacity transition used for the mobile menu */
    display: grid;
    grid-template-rows: 1fr;
    opacity: 1;
    transition: none;
    pointer-events: auto;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .navbar-items > * {
    overflow: visible;
  }

  .navbar-nav-list {
    flex-direction: column;
    align-items: left;
    gap: 1rem;
  }

  /* .navbar-link {
    padding: 0.5rem 0rem;
  } */

  .navbar-mobile-actions {
    display: none;
  }

  .navbar-auth {
    display: flex;
  }
  .social-links{
    display: flex;
  }
}

</style>