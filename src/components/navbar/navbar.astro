            </CloseIcon>
          </MenuIcon>
        </div>
        <div class="title-card">
        <a href="/" class="navbar-brand">
          <span class="navbar-brand-main">Dan N</span>
          <span class="navbar-brand-sub">guyen</span>
        </a>
        <div>Visual Development & Illustration</div>
        </div>
      <!-- </div> -->
      <MenuItems class="navbar-items hidden">
        <ul class="navbar-nav-list">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="navbar-link">
                      <span> {item.title}</span>
                      {/* {item.badge && (
                        <span class="navbar-badge">
                          New
                        </span>
                      )} */}
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <!-- <div class="navbar-mobile-actions">
          <Link href="#" style="muted" block size="md">Log in</Link>
          <Link href="#" size="md" block>Sign up</Link>
        </div> -->
      </MenuItems>
    </Astronav>
    <!-- <div>
      <div class="navbar-auth">
        <a href="#">Log in</a>
        <Link href="#" size="md">Sign up</Link>
      </div>
    </div> -->
    <!-- </StickyHeader> -->
  </header>
</Container>

<style>
.navbar-sticky-header {
  /* background-color: purple; */
  padding: 1.25rem;
  position: sticky;
  top: 0;
  z-index: 20;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  border-bottom: 1px solid transparent;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
}

.navbar-sticky-default {
  padding-top: 1.25rem;
  padding-bottom: 1.25rem;
  border-color: transparent;
}

.navbar-sticky-active {
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
  background-color: rgba(255, 255, 255, 0.8);
  border-color: #e5e7eb;
  backdrop-filter: blur(16px);
}

.navbar-header {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 1.25rem 1.25rem;
}

/* .navbar-top {
  display: flex;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  align-items: start;
  justify-content: space-between;
} */

.navbar-brand {
  font-size: 2rem;
  text-decoration: none;
  color: inherit;
  font-family: "variete-cabaret";
}

.navbar-brand-main {
  font-weight: 700;
  color: #0f172a;
}

.navbar-brand-sub {
  color: #64748b;
}

.navbar-menu-toggle {
  margin-left: auto;
  display: block;
  position: absolute;
  top: 1.25rem;
  right: 1rem;
}

.title-card {
  display: flex;
  flex-direction: column;
  align-items: start;
  /* margin-right: auto; */
  width: 100%;
}

@font-face {
  font-family: 'variete-cabaret';
  src: url('../../assets/fonts/variete-font/VarieteCabaret-zJZa.ttf') format('truetype');
  /* font-weight: normal;
  font-style: normal; */
}

/** reset button styling, remove border and bg. global needed because we're trying to style the astro-navbar
component and the scoped selectors here won't reach it otherwise */
:global(#astronav-menu) {
  padding: 0;
  border: 0;
  line-height: 0;
  appearance: none;
  -webkit-appearance: none;
  margin: 0;
  background-color: transparent;
}

/* .svg-container {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.navbar-open-icon,
.navbar-close-icon {
  display: inline-flex;
} */
.navbar-menu-svg {
  width: 2.5rem;
  height: 2.5rem;
  fill: black;
  /* color: #1f2937; */
}

/** global needed for .hidden class to get applied to astronav menu icon, and switch between open and close icons
otherwise both are shown at all times*/
:global(.hidden) .navbar-menu-svg{
  display: none !important;
}

.navbar-items {
  display: grid; /** so we can animate w/o hardcoding height; 
  makes container naturally grow in height as opposed to display: flex
  which gives a smoother animation */
  grid-template-rows: 0fr; /** start out closed */
  opacity: 0;
  /* transform: translateY(-0.75rem); */
  transition: grid-template-rows 0.5s ease, opacity 0.5s ease;
  pointer-events: none;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  margin-top: 0.5rem;
}

.navbar-items > * {
  min-height: 0;
  overflow: hidden;
}

.navbar-items:not(.hidden) {
  /** astro-navbar applies the .hidden class when the menu toggle is clicked */
  grid-template-rows: 1fr;
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.navbar-items.hidden {
  display: grid !important;
}

.navbar-nav-list {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  list-style: none;
  padding: 0;
  margin: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

:global(html),
:global(body) {
  overflow-x: clip;
}

.navbar-link {
  display: flex;
  align-items: center;
  padding: 0.5rem 0;
  color: #4b5563;
  text-decoration: none;
}

.navbar-link:hover {
  color: #111827;
}

.navbar-badge {
  margin-left: 0.25rem;
  padding: 0.125rem 0.5rem;
  font-size: 0.625rem;
  font-weight: 600;
  line-height: 1;
  text-transform: uppercase;
  color: #ffffff;
  background-color: #4f46e5;
  border-radius: 999px;
  animation: navbar-pulse 1.5s infinite;
}

.navbar-mobile-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-top: 0.75rem;
}

.navbar-auth {
  display: none;
  align-items: center;
  gap: 1rem;
}

@keyframes navbar-pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.04);
    opacity: 0.9;
  }
}

@media (min-width: 1024px) {
  .navbar-top {
    width: auto;
  }

  .title-card {
    align-items: center;
    padding: 3rem 0;
    /* margin-right: auto; */
    /* margin: auto; */
  }

  .navbar-brand {
    font-size: 3rem;
  }

  .navbar-menu-toggle {
    display: none;
  }

  .navbar-items {
    display: flex;
    flex-direction: row;
    overflow: visible;
    grid-template-rows: none;
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition: none;
    width: auto;
    margin-top: 0;
  }

  .navbar-items > * {
    overflow: visible;
  }

  /* .navbar-items:not(.hidden) {
    display: flex;
  } */

  .navbar-nav-list {
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
  }

  .navbar-link {
    padding: 0.5rem 0.75rem;
  }

  .navbar-mobile-actions {
    display: none;
  }

  .navbar-auth {
    display: flex;
  }
}

</style>