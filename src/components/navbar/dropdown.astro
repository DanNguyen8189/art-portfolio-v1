---
import { Dropdown as DropdownContainer, DropdownItems } from "astro-navbar";
const { title, lastItem, children } = Astro.props;
---

<li class="dropdown-item">
  <DropdownContainer class="dropdown-container">
    <button class="dropdown-toggle">
      <span>{title}</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="3"
        stroke="currentColor"
        class="dropdown-chevron">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
      </svg>
    </button>
    <DropdownItems class="dropdown-items-wrapper">
      <div
        class:list={[
          "dropdown-menu",
          lastItem ? "dropdown-menu--right" : "dropdown-menu--left",
        ]}>
        <div class="dropdown-panel">
          {
            children.map((item: any) => (
              <a href={item.path} class="dropdown-link">
                {item.title}
              </a>
            ))
          }
        </div>
      </div>
    </DropdownItems>
  </DropdownContainer>
</li>

<style>
.dropdown-item {
  position: relative;
  list-style: none;
  width: 100%;
}

.dropdown-container {
  position: relative;
  display: block;
  margin: 0;
  padding: 0;
  width: 100%;
}

/** NOTE: astro-navbar also attaches this to DropdownItems by default, need to specify button!!!*/
button.dropdown-toggle {
  
  display: flex;
  align-items: center;
  gap: 0.25rem;
  width: 100%;
  padding: 0.5rem 0;

  border: 0;
  background: transparent;
  color: #4b5563;
  cursor: pointer;
  font: inherit;
}

button.dropdown-toggle:hover {
  color: #111827;
}
/** class needed to override dropdownitems default dropdown-toggle class */
.dropdown-items-wrapper {
  display: none; /** need to specify this or else the <Dropdownitems sneaks up on large pages as well*/
  width: 100%;
  margin: 0;
  padding: 0;
}

.dropdown-container[aria-expanded="true"] > .dropdown-items-wrapper {
  display: block; /** sets menu vertical on mobile */
}

.dropdown-chevron {
  width: 0.75rem;
  height: 0.75rem;
  margin-top: 0.125rem;
  transition: transform 0.2s ease;
}

.dropdown-container[aria-expanded="true"] .dropdown-chevron {
  transform: rotate(180deg);
}

.dropdown-menu {
  display: none;
  width: 100%;
  height: 100%;
  /* margin-top: 0.25rem; */
}

.dropdown-container[aria-expanded="true"] .dropdown-menu {
  display: block;
}

.dropdown-menu--right {
  right: 0;
  left: auto;
}

.dropdown-menu--left {
  left: 0;
  right: auto;
}

.dropdown-panel {
  display: flex;
  flex-direction: column;
  padding: 0.5rem 0 0.5rem 0.75rem;
  background: transparent;
  border: 0;
}

.dropdown-link {
  display: block;
  padding: 0.35rem 0;
  color: #4b5563;
  text-decoration: none;
}

.dropdown-link:hover {
  color: #111827;
}

@media (min-width: 1024px) {
  .dropdown-container {
    display: flex;
    align-items: center;
    flex-direction: row;
  }
  button.dropdown-toggle {
    padding: 0.5rem 0.3rem;
  }

  .dropdown-menu {
    /* display: none; */
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 10;
    width: 12rem;
    margin-top: 0.25rem;
  }

  .dropdown-menu--right {
    right: 0;
    left: auto;
  }

  .dropdown-menu--left {
    left: 0;
    right: auto;
  }

  .dropdown-panel {
    padding: 0.75rem;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.375rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }
}

</style>