<style>
/* Reset */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
}
.footer {
  /* background-color: var(--color-slate-50); */
  background-color: white;
  color: var(--color-slate-900);
  /* padding-top: 2rem;
  padding-bottom: 2rem; */
  border-top: 1px solid var(--color-slate-200);
}

/* Container */
.footer-container {
  width: 100%;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  align-items: flex-start;
  /* max-width: 1280px; */
  /* margin: 0 auto; */
  /* padding: 0 var(--container-padding); */
}

/* Social Links */
.social-links {
  display: flex;
  gap: 1rem;
}
.social-link {
  color: var(--color-slate-600);
  transition: color var(--transition-duration);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.social-link:hover {
  color: var(--color-indigo-600);
}
.social-icon {
  height: 1rem;
  width: 1rem;
  display: block;
  color: inherit;
  fill: currentColor;
  stroke: currentColor;
  flex-shrink: 0;
}

/* Bottom Footer */
/* .bottom-footer {
  border-top: 1px solid var(--color-slate-200);
  padding-top: 1rem;
} */
.bottom-footer-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}
.copyright {
  color: var(--color-slate-600);
  font-size: 0.875rem;
  /* margin-bottom: 1rem; */
}
/* Responsive Breakpoints */
@media (min-width: 768px) {
  /* .footer-container {
    flex-direction: row;
  }
  .bottom-footer {
    margin-left: auto;
  } */
  /* .bottom-footer-content {
    flex-direction: row;
    justify-content: space-between;
  } */
}
</style>