---
import SocialIcons from "./SocialIcons.astro";
const today = new Date();
---

<!-- for reference later https://landinggo.com/component/footer-business-modern --><!-- icons from https://www.svgrepo.com/ -->
<section class="footer">
    <div class="footer-container">
        <div class="footer-section">
            <div class="copyright">Website built by me! :D</div>
        </div>
        <div class="footer-section">
            <SocialIcons
                border={false}
                color="var(--color-slate-600)"
                gap="1rem"
                size="1rem"
            />
        </div>
        <div class="bottom-footer">
            <div class="bottom-footer-content">
                <div class="copyright">
                    © {today.getFullYear()} Dan Nguyen. All rights reserved.
                </div>
            </div>
        </div>
    </div>
</section>
