---
import Gallery from "./Gallery.tsx";
import { getPhotosFromContent, type Photo } from "../lib/photos.ts";
import { Masonry } from 'astro-masonry';
import { Image } from "astro:assets";
import Lightbox from './Lightbox.astro';

type Props = {
    folder?: string;
    title?: string;
    description?: string;
    photos?: Photo[];
};

const {
    folder = "illustrations",
    title,
    description,
    photos: providedPhotos,
} = Astro.props as Props;

const photos = providedPhotos ?? getPhotosFromContent(folder);
---

<main class="container">
    {
        (title || description) && (
            <header class="gallery-page-header">
                {title && <h1>{title}</h1>}
                {description && <p>{description}</p>}
            </header>
        )
    }
    <Gallery client:load photos={photos} />
    <!-- needs to be hydrated/made interactive on page load so that react can calculate image widths and heights.
  react-photo-album containers require this to figure out row/column breaks. Without it, the album container
  renders but is empty. Server gives structure skeleton, client computes layout--->
    
    <!-- <Masonry
        breakpointCols={{
            default: 3,
            1200: 3,
            700: 2,
            500: 1,
        }}
        class="astro-masonry-grid"
        >
        {
            photos.map((photo) => (
                // <a href={`/photo/${photo.src}`}>
                <Image
                    src={photo.metadata}
                    alt={photo.alt ?? ""}
                    class="image"
                    loading="lazy"
                />
                // <Lightbox image={photo.metadata} alt={photo.alt} />
            ))
        }
    </Masonry> -->
</main>

<style>
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .container {
        width: 100%;
        /* max-width: 1168px; */
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 0 auto;
        padding: 16px;
        box-sizing: border-box;
    }

    .gallery-page-header {
        padding-bottom: 1rem;
        /* max-width: 900px; */
        text-align: center;
    }

    .gallery-page-header h1 {
        font-size: 2.5rem;
        margin: 0;
    }

    /* global needed because these are created dynamically by astro-masonry */
    :global(.astro-masonry-grid) {
        display: flex;
        gap: .75rem;
    }
    :global(.astro-masonry-grid_column) {
        display: flex;
        flex-direction: column;
        gap: .75rem;
    }

    .image {
        width: 100%;
        height: 100%;
        /* animation: fadeIn 700ms ease forwards; */
    }
    .gallery-page-header p {
        color: var(--color-slate-500);
        white-space: pre-line; /** newline detection */
    }
    @media (min-width: 1024px) {
        .gallery-page-header {
            width: 70%;
        }
    }
</style>
