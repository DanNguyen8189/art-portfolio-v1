---
import Gallery from "./Gallery.tsx";
import { getPhotosFromContent, type Photo } from "../lib/photos";

type Props = {
  folder?: string;
  title?: string;
  description?: string;
  photos?: Photo[];
};

const { folder = "illustrations", title, description, photos: providedPhotos } = Astro.props as Props;
const photos = providedPhotos ?? getPhotosFromContent(folder);
---


<main class="container">
  {(title || description) && (
    <header class="gallery-page-header">
      {title && <h1>{title}</h1>}
      {description && <p>{description}</p>}
    </header>
  )}
  <Gallery client:load photos={photos} />
  <!-- needs to be hydrated/made interactive on page load so that react can calculate image widths and heights.
  react-photo-album containers require this to figure out row/column breaks. Without it, the album container
  renders but is empty. Server gives structure fast, client computes layout--->
</main>

<style>
  .container {
    width: 100%;
    /* max-width: 1168px; */
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
    padding: 16px;
    box-sizing: border-box;
  }

  .gallery-page-header {
    padding-bottom: 1rem;
    /* max-width: 900px; */
    text-align: center;
  }
  

  .gallery-page-header h1 {
    font-size: 2.5rem;
    margin: 0;
  }

  .gallery-page-header p {
    color: var(--color-slate-500);
    white-space: pre-line; /** newline detection */
  }
  @media (min-width: 1024px) {
    .gallery-page-header{
      width: 70%;
    }
  }
</style>