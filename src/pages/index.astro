---
import landingBg from '@/assets/landing-bg.png';
import SocialIcons from '@/components/SocialIcons.astro'
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>Dan Nguyen</title>
    </head>
    <body>
        <!-- <slot /> -->
        <img id="background" src={landingBg.src} alt="" fetchpriority="high" />
        <section class="hero">
            <div class="title-card">
                <a href="/" class="brand">
                <span class="brand-main">Dan N</span>
                <span class="brand-sub">guyen</span>
                </a>
                <div>Visual Development and Illustration</div>
                <div class="intro"> Hi! I’m Dan, an artist residing in LA. I'm a background artist in tv animation. Welcome!</div>
            </div>
        <div class="social-icons">
        <SocialIcons
            border={true}
            color="white"
            gap="1rem"
            size="1rem"
        />
        </div>
            <a href="/illustrations" class="btn">ENTER SITE</a>
        </section>
    </body>
</html>

<style>
    @keyframes fadeIn {
		from {
		opacity: 0;
		}
		to {
		opacity: 1;
		}
	}
    @keyframes topFadeIn {
		from {
		opacity: 0;
		transform: translateY(-20px);
		}
		to {
		opacity: 1;
		transform: translateY(0);
		}
	}
	@keyframes leftFadeIn {
		from {
		opacity: 0;
		transform: translateX(-50px);
		}
		to {
		opacity: 1;
		transform: translateX(0);
		}
	}
	@keyframes rightFadeIn {
		from {
		opacity: 0;
		transform: translateX(50px);
		}
		to {
		opacity: 1;
		transform: translateX(0);
		}
	}
    html,
    body {
        margin: 0;
        /* width: 100%;
        height: 100%; */
        min-height: 100vh;
        margin: 0;
        /* display: grid;
        grid-template-rows: auto 1fr auto; */
        display: flex;
        align-items: flex-end;
        justify-content: center;
        width: 100%;
        background-color: rgba(0,0,0,.5);
        font-family: var(--font-sans);
        line-height: 1.5;
    }
    #background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        object-fit: cover;
        object-position: center;
        pointer-events: none;
        z-index: -1;
        animation: fadeIn 700ms ease forwards;
        /* filter: brightness(0.8); */
    }
    .hero {
        width: 100%;
        padding: 3rem;
        max-width: 1250px;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .title-card {
        display: flex;
        flex-direction: column;
        color: white;
        animation: topFadeIn 700ms ease forwards;
    }
    .brand {
        font-size: 2.5rem;
        text-decoration: none;
        color: inherit;
        font-family: var(--font-brand);
    }
    .intro {
        margin-top: 2rem;
    }
    .social-icons {
        animation: topFadeIn 700ms ease forwards;
    }
    .btn {
        align-self: flex-end;
        display: inline-block;
        padding: 0.6rem 1.2rem;
        background-color: white;
        color: var(--color-slate-600);
        text-decoration: none;
        font-weight: 600;
        transition: background-color 0.2s ease;
        animation: rightFadeIn 700ms ease forwards;
    }

    .btn:hover {
        background-color: var(--color-indigo-600);
        color: white;
    }
</style>